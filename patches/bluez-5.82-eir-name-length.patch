Description: Clamp untrusted EIR names before fixed-buffer conversion
Origin: backport, https://github.com/bluez/bluez/commit/381b5d0d208972586282116d333865ba93b8dec2
Bug-Debian: https://bugs.debian.org/1145869
Forwarded: not-needed
CVE: CVE-2026-80186

--- a/src/eir.c
+++ b/src/eir.c
@@ -128,6 +128,8 @@ static char *name2utf8(const uint8_t *name, uint8_t len)
 	char utf8_name[HCI_MAX_NAME_LENGTH + 2];
 	int i;
 
+	len = MIN(len, HCI_MAX_NAME_LENGTH);
+
 	if (g_utf8_validate((const char *) name, len, NULL))
 		return g_strndup((char *) name, len);
 
--- a/unit/test-eir.c
+++ b/unit/test-eir.c
@@ -534,6 +534,41 @@ static void test_basic(const void *data)
 	tester_test_passed();
 }
 
+static void test_oversized_invalid_name(const void *data)
+{
+	struct eir_data eir = { 0 };
+	uint8_t payload[255] = { 254, EIR_NAME_COMPLETE };
+	size_t i;
+
+	memset(payload + 2, 'A', sizeof(payload) - 2);
+	payload[2 + HCI_MAX_NAME_LENGTH - 1] = 0xff;
+
+	eir_parse(&eir, payload, sizeof(payload));
+	g_assert_nonnull(eir.name);
+	g_assert_cmpuint(strlen(eir.name), ==, HCI_MAX_NAME_LENGTH - 1);
+	for (i = 0; i < HCI_MAX_NAME_LENGTH - 1; i++)
+		g_assert_cmpint(eir.name[i], ==, 'A');
+	eir_data_free(&eir);
+
+	tester_test_passed();
+}
+
+static void test_maximum_valid_name(const void *data)
+{
+	struct eir_data eir = { 0 };
+	uint8_t payload[HCI_MAX_NAME_LENGTH + 2] = {
+		HCI_MAX_NAME_LENGTH + 1, EIR_NAME_COMPLETE
+	};
+
+	memset(payload + 2, 'A', HCI_MAX_NAME_LENGTH);
+	eir_parse(&eir, payload, sizeof(payload));
+	g_assert_nonnull(eir.name);
+	g_assert_cmpuint(strlen(eir.name), ==, HCI_MAX_NAME_LENGTH);
+	eir_data_free(&eir);
+
+	tester_test_passed();
+}
+
 static void print_debug(const char *str, void *user_data)
 {
